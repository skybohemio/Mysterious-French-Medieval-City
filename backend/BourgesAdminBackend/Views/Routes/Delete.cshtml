@model BourgesAdminBackend.Models.TourRoute
@{
    ViewData["Title"] = $"Delete Route: {Model.NameFr}";
    var sitesDict = ViewBag.SitesDict as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="card p-4 bg-white shadow-sm max-width-md mx-auto my-5" style="max-width: 600px;">
    <div class="text-center mb-4">
        <span class="bg-danger-subtle text-danger p-4 rounded-circle d-inline-block mb-3">
            <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
        </span>
        <h3 class="fw-bold text-dark">Are you absolutely sure?</h3>
        <p class="text-muted">You are about to delete the tour route <strong>@Model.NameFr</strong> from the catalog.</p>
    </div>

    <div class="bg-light p-3 rounded mb-4 border border-light-subtle">
        <div class="row g-2 mb-2">
            <div class="col-4 text-muted small fw-bold">ROUTE ID</div>
            <div class="col-8 small font-monospace">#@Model.Id</div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-4 text-muted small fw-bold">EST. DURATION</div>
            <div class="col-8 small font-semibold">@Model.DurationMin minutes</div>
        </div>
        <div class="row g-2">
            <div class="col-4 text-muted small fw-bold">STOPS</div>
            <div class="col-8">
                <span class="badge bg-secondary">@Model.SiteIds.Count stops</span>
                <div class="text-muted small mt-1">
                    @{
                        var stopsList = Model.SiteIds.Select(id => sitesDict.ContainsKey(id) ? sitesDict[id] : $"Unknown stop #{id}");
                        @string.Join(" ➔ ", stopsList)
                    }
                </div>
            </div>
        </div>
    </div>

    <p class="text-danger small text-center mb-4"><i class="fa-solid fa-circle-info me-1"></i> Warning: This action is permanent and cannot be undone.</p>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-light border w-50 py-2.5">Cancel</a>
        <button type="submit" class="btn btn-danger w-50 py-2.5"><i class="fa-solid fa-trash-can me-2"></i> Permanently Delete</button>
    </form>
</div>
